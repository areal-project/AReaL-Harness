{
  "name": "@areal/workbench-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "exports": {
    "./trajectory": "./src/domains/trajectory.cjs",
    "./trajectory-apply": "./src/domains/trajectory-apply.cjs",
    "./feedback": "./src/domains/feedback.cjs",
    "./feedback-context": "./src/domains/feedback-context.cjs",
    "./desktop/*": "./src/desktop/*",
    "./package.json": "./package.json",
    "./host-library-store": {
      "types": "./src/host-library-store.ts",
      "default": "./src/generated/host-library-store.cjs"
    }
  },
  "dependencies": {
    "@areal/browser-automation": "workspace:*",
    "@areal/chatgpt-provider": "workspace:*",
    "@areal/client": "workspace:*",
    "@areal/gen-ui": "workspace:*",
    "@areal/provider-config": "workspace:*",
    "@areal/remote": "workspace:*",
    "@areal/runtime-client": "workspace:*",
    "@areal/workbench": "workspace:*",
    "@areal/workspace-git": "workspace:*",
    "pkijs": "3.4.1",
    "qrcode": "1.5.4",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1"
  }
}
