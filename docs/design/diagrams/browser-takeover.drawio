<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="Human takeover — local control before coordination" id="browser-takeover"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="8" guides="1" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Human takeover — local control before coordination" style="text;html=1;fontFamily=Georgia;fontSize=34;fontColor=#0F1012;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="52" width="1472" height="48" /></mxCell><mxCell id="sub" value="Design proposal: one writer, honest outcomes, and private manual interaction." style="text;html=1;fontSize=16;fontColor=#3A3D44;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="109" width="1472" height="32" /></mxCell><mxCell id="status" value="DESIGN PROPOSAL — NOT IMPLEMENTED" style="text;html=1;fontSize=13;fontColor=#8B8F97;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="162" width="1472" height="28" /></mxCell><mxCell id="n0" value="&lt;b&gt;1  User takes over&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trusted UI control&lt;br&gt;Mouse or keyboard&lt;br&gt;Works while Core&lt;br&gt;is unavailable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="264" width="192" height="224" /></mxCell><mxCell id="n1" value="&lt;b&gt;2  Local fence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Increase controlEpoch&lt;br&gt;Reject the old lease&lt;br&gt;No wait behind&lt;br&gt;an action queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="320" y="264" width="192" height="224" /></mxCell><mxCell id="n2" value="&lt;b&gt;3  Quiesce input&lt;/b&gt;&lt;br&gt;&lt;br&gt;Drop unsent steps&lt;br&gt;Settle native input&lt;br&gt;Release held keys&lt;br&gt;Pause agent reads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="576" y="264" width="192" height="224" /></mxCell><mxCell id="n3" value="&lt;b&gt;4  Human control&lt;/b&gt;&lt;br&gt;&lt;br&gt;User can interact&lt;br&gt;Private login phase&lt;br&gt;No automatic&lt;br&gt;agent reclaim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="832" y="264" width="192" height="224" /></mxCell><mxCell id="n4" value="&lt;b&gt;5  Core evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Notify asynchronously&lt;br&gt;Confirmed facts stay&lt;br&gt;Ambiguity is UNKNOWN&lt;br&gt;No automatic replay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1088" y="264" width="192" height="224" /></mxCell><mxCell id="n5" value="&lt;b&gt;6  Explicit resume&lt;/b&gt;&lt;br&gt;&lt;br&gt;New control epoch&lt;br&gt;Inspect UNKNOWN first&lt;br&gt;Fresh observation&lt;br&gt;Then a new action" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1344" y="264" width="192" height="224" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="256" y="352" /><mxPoint as="targetPoint" x="320" y="352" /></mxGeometry></mxCell><mxCell id="el0" value="" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="302" width="250" height="50" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="512" y="352" /><mxPoint as="targetPoint" x="576" y="352" /></mxGeometry></mxCell><mxCell id="el1" value="" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="516" y="302" width="250" height="50" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="768" y="352" /><mxPoint as="targetPoint" x="832" y="352" /></mxGeometry></mxCell><mxCell id="el2" value="" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="772" y="302" width="250" height="50" /></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1024" y="352" /><mxPoint as="targetPoint" x="1088" y="352" /></mxGeometry></mxCell><mxCell id="el3" value="" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="1028" y="302" width="250" height="50" /></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1280" y="352" /><mxPoint as="targetPoint" x="1344" y="352" /></mxGeometry></mxCell><mxCell id="el4" value="" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="1284" y="302" width="250" height="50" /></mxCell><mxCell id="note0" value="Steps 2–4 do not wait for step 5. Local control and privacy fencing are effective even when Core cannot answer." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="733" width="1472" height="32" /></mxCell><mxCell id="note1" value="Cancellation cannot roll back input already delivered to a website. A lost receipt remains UNKNOWN in Core history." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="767" width="1472" height="32" /></mxCell><mxCell id="note2" value="Resume is an explicit user authorization, not a replay of the old call. New input must use a newly observed page." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="801" width="1472" height="32" /></mxCell><mxCell id="note3" value="Controller, host, page, document, control and viewport identities are separate; an event cursor never grants permission." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="835" width="1472" height="32" /></mxCell></root></mxGraphModel></diagram></mxfile>