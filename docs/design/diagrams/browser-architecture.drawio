<mxfile host="app.diagrams.net" type="device"><diagram name="Shared Browser — ownership and execution" id="browser-architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="8" guides="1" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Shared Browser — ownership and execution" style="text;html=1;fontFamily=Georgia;fontSize=34;fontColor=#0F1012;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="52" width="1472" height="48" /></mxCell><mxCell id="sub" value="AReaL Harness design: extend the existing authenticated callback path and native preview." style="text;html=1;fontSize=16;fontColor=#3A3D44;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="109" width="1472" height="32" /></mxCell><mxCell id="status" value="DESIGN PROPOSAL — NOT IMPLEMENTED" style="text;html=1;fontSize=13;fontColor=#8B8F97;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="162" width="1472" height="28" /></mxCell><mxCell id="n0" value="&lt;b&gt;Core&lt;/b&gt;&lt;br&gt;&lt;br&gt;Thread / Turn / approval&lt;br&gt;Durable intent + history&lt;br&gt;Client-backed receipts&lt;br&gt;No Electron dependency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="264" width="240" height="224" /></mxCell><mxCell id="n1" value="&lt;b&gt;Desktop adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bound ToolHost connection&lt;br&gt;Authentication + routing&lt;br&gt;Reply/cancel correlation&lt;br&gt;No agent loop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="368" y="264" width="240" height="224" /></mxCell><mxCell id="n2" value="&lt;b&gt;Browser Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Electron Main&lt;br&gt;Pages / contexts / epochs&lt;br&gt;Input fence + narrow CDP&lt;br&gt;Native resource authority" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="672" y="264" width="240" height="224" /></mxCell><mxCell id="n3" value="&lt;b&gt;Live Browser Page&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existing WebContentsView&lt;br&gt;One DOM + site Session&lt;br&gt;No Node / product bridge&lt;br&gt;Same object as preview" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="976" y="264" width="240" height="224" /></mxCell><mxCell id="n4" value="&lt;b&gt;GUI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tabs + annotations&lt;br&gt;Control + evidence&lt;br&gt;Drafts + projections&lt;br&gt;Visible human takeover" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A1A3;fontColor=#3A3D44;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="264" width="240" height="224" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="304" y="352" /><mxPoint as="targetPoint" x="368" y="352" /></mxGeometry></mxCell><mxCell id="el0" value="call /&lt;br&gt;receipt" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="306" y="300" width="250" height="50" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="608" y="352" /><mxPoint as="targetPoint" x="672" y="352" /></mxGeometry></mxCell><mxCell id="el1" value="private&lt;br&gt;channel" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="610" y="300" width="250" height="50" /></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="912" y="352" /><mxPoint as="targetPoint" x="976" y="352" /></mxGeometry></mxCell><mxCell id="el2" value="scoped&lt;br&gt;CDP" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="300" width="250" height="50" /></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1216" y="352" /><mxPoint as="targetPoint" x="1280" y="352" /></mxGeometry></mxCell><mxCell id="el3" value="same&lt;br&gt;window" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="300" width="250" height="50" /></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3A3D44;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1400" y="488" /><mxPoint as="targetPoint" x="792" y="488" /><Array as="points"><mxPoint x="1400" y="592" /><mxPoint x="792" y="592" /></Array></mxGeometry></mxCell><mxCell id="el4" value="Human control: priority local fence before Core coordination" style="text;html=1;align=left;fontSize=12;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="552" width="250" height="50" /></mxCell><mxCell id="note0" value="Ownership stays explicit: Core owns the task record; Main owns physical pages; the Renderer owns only unsent drafts and UI state." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="733" width="1472" height="32" /></mxCell><mxCell id="note1" value="Runtime still owns development servers and code/file execution. A client browser is not automatically inside the Runtime sandbox." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="767" width="1472" height="32" /></mxCell><mxCell id="note2" value="No second browser daemon, no public application-wide CDP endpoint, and no duplicate Agent Loop." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="801" width="1472" height="32" /></mxCell><mxCell id="note3" value="R2 target: shared-page work, takeover, annotations, diagnostics and code verification. Persistent Browser Profiles are deferred." style="text;html=1;align=left;fontSize=16;fontColor=#3A3D44;" vertex="1" parent="1"><mxGeometry as="geometry" x="64" y="835" width="1472" height="32" /></mxCell></root></mxGraphModel></diagram></mxfile>