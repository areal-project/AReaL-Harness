  "foundation": {
    "ui-font-size": {
      "$type": "dimension",
      "$value": {
        "value": 14.0,
        "unit": "px"
      },
      "$description": "界面默认字号；用户偏好可覆盖",
      "$extensions": {
        "build.areal.ui": {
          "tailwind": false
        }
      }
    },
    "ui-font-weight": {
      "$type": "number",
      "$value": 400.0,
      "$description": "界面常规字重",
      "$extensions": {
        "build.areal.ui": {
          "tailwind": false
        }
      }
    },
    "motion-fast": {
      "$type": "duration",
      "$value": {
        "value": 100.0,
        "unit": "ms"
      },
      "$description": "悬停、按下等即时反馈的过渡时长；减少动效时为 0",
      "$extensions": {
        "build.areal.ui": {
          "tailwind": false
        }
      }
