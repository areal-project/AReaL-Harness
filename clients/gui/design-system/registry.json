  "patterns": [
    {
      "id": "P-SETTINGS",
      "intent": "修改偏好或配置",
      "components": [
        "SettingsPage",
        "SettingsSection",
        "SettingsGroupCard",
        "SettingsRow"
      ],
      "reference": "renderer/src/settings/DisplaySettings.tsx",
      "slots": [
        "label",
        "control",
        "detail"
      ],
      "states": [
        "default",
        "busy",
        "failed",
        "unknown",
        "disabled"
      ],
      "variation": "分组、字段、文案与现有控件类型",
      "acceptance": "标签/控件对齐，窄窗换行，值和反馈真实"
    },
    {
      "id": "P-RESOURCES",
      "intent": "查找并管理资源",
      "components": [
        "SettingsSearchInput",
        "SettingsSegmentedTabs",
        "Button",
        "Switch",
        "SettingsDisclosure",
        "Feedback"
      ],
      "reference": "renderer/src/settings/PluginCenter.tsx",
      "slots": [
        "toolbar",
        "list",
        "detail"
      ],
      "states": [
        "loading",
        "empty",
        "ready",
        "failed"
      ],
      "variation": "当前市场与资源分类、查询、详情、项目启用状态和局部读取反馈",
      "acceptance": "限插件目录/详情及当前项目启停；安装、启用和连接分开；原提交只读核对，返回保留上下文"
    },
    {
      "id": "P-CONVERSATION",
      "intent": "阅读并推进任务",
      "components": [
        "Messages",
        "TurnProgress",
        "TurnExecution",
        "ToolEvent",
        "ConversationComposer",
        "CommandDetails",
        "AgentConversationPane",
        "SentAttachment",
        "ComposerSurface",
        "SideChatPane",
        "SidePane",
        "Feedback"
      ],
      "reference": "renderer/src/design-system/ConversationFlowExercise.tsx",
      "slots": [
        "timeline",
        "composer",
        "context"
      ],
      "states": [
        "ready",
        "busy",
        "failed",
        "unknown",
        "reading-history",
        "following-latest",
        "tool-details",
        "completed",
        "command-streaming",
        "parallel-working",
        "image-preview",
        "child-conversation"
      ],
      "variation": "消息类型、工具结果、合法动作与上下文",
      "acceptance": "权威状态、内容层级与阅读意图独立；按信息流合同验收完成收敛、人工展开和返回最新；未知提交不重放",
      "ruleSource": "design-system/patterns.md",
      "rules": [
        "CONV-OWNER-01",
        "CONV-INPUT-01",
        "CONV-CONTENT-01",
        "CONV-GROUP-01",
        "CONV-DISCLOSURE-01",
        "CONV-READ-01",
        "CONV-RESOURCE-01",
        "CONV-COMMAND-01",
        "CONV-PARALLEL-01",
        "CONV-SCENARIO-01"
      ]
    },
    {
      "id": "P-DECISION",
      "intent": "回答或批准请求",
      "components": [
        "DecisionCard",
        "ApprovalRequest",
        "Feedback"
      ],
      "reference": "renderer/src/ApprovalRequest.tsx",
      "slots": [
        "request",
        "actions",
        "feedback"
      ],
      "states": [
        "ready",
        "busy",
        "failed",
        "unknown"
      ],
      "variation": "请求正文及已有决策动作",
      "acceptance": "关键参数可核对，动作和结果可达"
    },
    {
      "id": "P-DETAIL",
      "intent": "阅读或编辑详情",
      "components": [
        "SettingsDialog",
        "SettingsDisclosure",
        "Feedback"
      ],
      "reference": "renderer/src/settings/common.tsx",
      "slots": [
        "body",
        "actions"
      ],
      "states": [
        "ready",
        "busy",
        "failed"
      ],
      "variation": "表单字段、正文及受控 footer",
      "acceptance": "返回/关闭路径和焦点恢复；不叠多层弹窗"
    },
    {
      "id": "P-STATUS",
      "intent": "了解状态并恢复",
      "components": [
        "Feedback",
        "EmptySettings"
      ],
      "reference": "renderer/src/settings/ServiceStatusSettings.tsx",
      "slots": [
        "status",
        "recovery"
      ],
      "states": [
        "loading",
        "empty",
        "ready",
        "failed",
        "unknown"
      ],
      "variation": "状态说明、必要详情及可行恢复入口",
      "acceptance": "离线/失败/未知区分，静默刷新保留已确认内容"
    }
  ],
