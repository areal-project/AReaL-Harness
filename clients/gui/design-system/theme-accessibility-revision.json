{
  "baseVersion": "0.4.1",
  "source": "D4 accessibility correction and D-005 text contrast floor; original theme-baseline.json remains frozen.",
  "roles": [
    {
      "name": "--color-foreground-subtle",
      "reason": "Maintain text hierarchy above the corrected metadata role."
    },
    {
      "name": "--color-foreground-subtlest",
      "reason": "Meet 4.5:1 for active small metadata at every default contrast level."
    },
    {
      "name": "--color-process-settled",
      "reason": "Keep settled status distinct from disabled controls while making its text readable."
    },
    {
      "name": "--color-settings-secondary",
      "reason": "Follow the corrected secondary text role on light settings cards."
    }
  ],
