+"use strict";
+const got = require("got");
+const fs = require("fs");
+const path = require("path");
+const { pipeline } = require("stream/promises");
+const { getProxyForUrl } = require("proxy-from-env");
+// 保留 builder 已有的 Got agent、TLS 与 request deadline；Fetch 不解释这些选项。
+exports.legacyGotDownloader = {
+  async download(url, target, options = {}) {
+    const { quiet, getProgressCallback, arealEnvironmentProxy, ...requestOptions } = options;
+    // 仅自动环境代理受 NO_PROXY 限制；显式传入的自定义 agent 保持原语义。
+    if (arealEnvironmentProxy && !getProxyForUrl(url)) delete requestOptions.agent;
+    await fs.promises.mkdir(path.dirname(target), { recursive: true });
+    const request = got.stream(url, requestOptions);
+    if (getProgressCallback) request.on("downloadProgress", progress => { void getProgressCallback(progress); });
+    await pipeline(request, fs.createWriteStream(target));
+  },
+};
