{
  "name": "areal-gui-workspace",
  "version": "0.1.10",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @areal/gui-renderer build",
    "typecheck": "pnpm --filter @areal/gui-renderer typecheck && pnpm --filter @areal/gui-renderer exec tsc --allowJs --checkJs --noEmit --skipLibCheck --target ES2022 --module NodeNext ../packages/workbench/client/desktop-contract.cjs",
    "start": "node scripts/start.mjs",
    "package": "node scripts/package.mjs",
    "verify": "node scripts/verify-public.mjs && node scripts/design-system-audit.mjs && node --test scripts/side-restore.test.mjs scripts/operation-contract.test.cjs scripts/side-model-intent.test.mjs scripts/startup-recovery.test.mjs scripts/system-proxy.test.mjs scripts/history.test.mjs scripts/macos-service.test.mjs scripts/feedback.test.mjs",
    "test:task-conversation": "node scripts/task-conversation-smoke.mjs",
    "test:lifecycle": "node scripts/startup-recovery-smoke.mjs && node scripts/lifecycle-smoke.mjs",
    "test:lifecycle:legacy": "node scripts/legacy-lifecycle-smoke.mjs",
    "test:queue": "node scripts/queue-smoke.mjs",
    "test:interactions": "node scripts/interaction-smoke.mjs",
    "test:composer": "node scripts/composer-smoke.mjs",
    "test:model-selection": "node scripts/model-selection-smoke.mjs",
    "test:history-compat": "node scripts/history-copy-smoke.mjs",
    "test:connection": "node scripts/connection-smoke.mjs",
    "test:history": "node --test scripts/history.test.mjs && node scripts/history-smoke.mjs",
    "test:architecture": "node scripts/architecture-smoke.mjs",
    "test:conversation-derivation": "node scripts/conversation-derivation-smoke.mjs",
    "test:trajectory": "node --test scripts/trajectory.test.mjs scripts/trajectory-polling.test.mjs scripts/trajectory-toggle.test.mjs",
    "test:trajectory-config": "node scripts/trajectory-config-smoke.mjs",
    "test:trajectory-ui": "node scripts/trajectory-ui-smoke.mjs",
    "test:remote-observation": "node scripts/remote-observation-smoke.mjs",
    "test:remote-pairing-e2e": "node scripts/remote-pairing-e2e.mjs",
    "test:remote-observation-e2e": "node scripts/remote-observation-e2e.mjs",
    "test:e2e": "node scripts/migration-smoke.mjs",
    "sign:mac": "node scripts/notarize-macos.mjs",
    "test:update": "node scripts/update-smoke.mjs",
    "test:core-process": "node scripts/core-process-smoke.mjs",
    "test:browser-feasibility": "node scripts/browser-feasibility.mjs",
    "test:browser-attach": "node scripts/browser-attach-smoke.mjs",
    "test:browser-annotations": "node scripts/browser-annotation-smoke.mjs",
    "test:browser-contracts": "node --test scripts/browser-read-contract.test.mjs scripts/browser-network-policy.test.mjs scripts/browser-diagnostics-contract.test.cjs scripts/browser-evidence-contract.test.mjs scripts/browser-startup-contract.test.mjs scripts/browser-observation-privacy.test.cjs",
    "test:remote-command": "node scripts/remote-command-contract.mjs",
    "test:remote-command-e2e": "node scripts/remote-session-commands-e2e.mjs",
    "test:remote-session": "node scripts/remote-session-contract.mjs",
    "test:remote-gui-e2e": "node scripts/remote-gui-workbench-e2e.mjs",
    "test:remote-session-body": "node --test scripts/remote-session-body.test.mjs scripts/remote-session-body-browser.test.mjs",
    "test:remote-session-e2e": "node scripts/remote-session-observation-e2e.mjs",
    "test:remote-work-overview": "node scripts/remote-work-overview-e2e.mjs",
    "test:remote-interaction": "node scripts/remote-interaction-contract.mjs",
    "test:remote-browser": "node --test scripts/remote-browser-state.test.mjs scripts/remote-browser-lifecycle-contract.mjs",
    "test:remote-static": "node --test scripts/remote-static-assets.test.mjs scripts/remote-static-direct-contract.mjs",
    "test:remote-task-pause": "node scripts/remote-task-pause-contract.mjs",
    "test:remote-task-question": "node scripts/remote-task-question-contract.mjs",
    "test:remote-gui-quit": "node scripts/remote-gui-quit-e2e.mjs",
    "test:remote-review": "node scripts/remote-review-contract.mjs && node scripts/remote-raster-contract.mjs && node scripts/remote-review-dom-contract.mjs && node scripts/remote-review-transport-contract.mjs",
    "test:remote-network": "node scripts/remote-network-smoke.mjs && node --test scripts/remote-network-host.test.mjs scripts/remote-network-settings.test.mjs",
    "export:remote": "node scripts/export-remote-assets.mjs renderer/dist",
    "test:remote-relay": "node --test scripts/remote-relay-host.test.mjs scripts/remote-relay-transport-contract.mjs scripts/remote-relay-export.test.mjs scripts/remote-relay-wire.test.mjs",
    "design:dev": "pnpm --filter @areal/gui-renderer design:dev",
    "design:build": "pnpm --filter @areal/gui-renderer design:build",
    "test:design": "node scripts/design-system-smoke.mjs",
    "verify:design": "node scripts/design-system-audit.mjs",
    "test:regressions": "node --test scripts/browser-observation-privacy.test.cjs scripts/trajectory-polling.test.mjs scripts/builder-download.test.mjs",
    "test:proxy": "node --test scripts/system-proxy.test.mjs",
    "test:feedback": "node --test scripts/feedback.test.mjs && node scripts/feedback-ui-smoke.mjs",
    "test:feedback-native": "node scripts/feedback-native-smoke.mjs",
    "test:trajectory-native": "node scripts/trajectory-native-smoke.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4",
    "prettier": "3.9.8"
  }
}
