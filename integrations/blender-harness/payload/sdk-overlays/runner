    process = None
    stopping = False
    timed_out = False
    adapter_error = False
    threads = []

    def stop(_signal, _frame):
        nonlocal stopping
        stopping = True
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        write_json(output / 'runtime-utilities.json', prepare_utilities(root))
        (model, endpoint, key) = model_connection()
