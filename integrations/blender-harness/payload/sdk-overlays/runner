def capture_native_terminal(output, threads, process, started, timed_out, stopping, stage):
    import json
    import os
    import time
    turns = [turn for thread in threads for turn in thread.get('turns', [])]
    receipt = {'status': 'ERROR', 'implementation': 'rust-core-runtime', 'receipt_phase': 'TERMINAL_CAPTURED_COLLECTION_PENDING', 'exit_code': process.returncode, 'turn_statuses': [turn.get('status') for turn in turns], 'error': [turn.get('error') for turn in turns], 'duration_ms': int((time.monotonic() - started) * 1000), 'collection': {'status': 'PENDING', 'stage': stage}, 'observed_runner_timeout': bool(timed_out), 'observed_external_interruption': bool(stopping), 'raw': {'outcome': {'schema': 'areal.envarena-outcome.v1', 'code': 'HARNESS_INTERNAL_ERROR', 'class': 'infrastructure', 'source': 'runner_collection', 'details': {'reason': 'terminal_archive_pending', 'stage': stage}}}}
    pending = output / '.native-receipt.capture.tmp'
    with pending.open('w') as stream:
        json.dump(receipt, stream)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(pending, output / 'native-receipt.json')
