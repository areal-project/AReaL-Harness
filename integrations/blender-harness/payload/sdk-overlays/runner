        write_json(output / 'runtime-utilities.json', {'workspace': workspace, 'budget_profile': 'swe-mm-256k', **json.loads((output / 'runtime-utilities.json').read_text())})
        with tempfile.TemporaryDirectory(prefix='areal-arena-') as temp:
            state = Path(temp)
