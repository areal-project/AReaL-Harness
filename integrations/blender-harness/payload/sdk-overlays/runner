def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + '.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2))
    temporary.replace(path)

def prepare_input(query, assets=Path('/problem_assets'), allowed_names=None):
    from image_ingress import prepare, MIMES
    helper=Path(__file__).resolve().parent/'image-ingress-helper'
    sources=[]
    if assets.is_dir():
        for path in sorted(assets.iterdir()):
            if allowed_names is not None and path.name not in allowed_names:
                continue
            if path.suffix.lower() in MIMES:
                if path.is_symlink() or not path.is_file():raise ValueError('Regular approved image required')
                sources.append((str(path),path.read_bytes(),MIMES[path.suffix.lower()]))
            elif path.suffix.lower() in {'.gif','.bmp','.tif','.tiff'}:
                raise ValueError('Unsupported input image must be normalized before execution')
    return prepare(query,sources,helper,'36378ef011508d2f6b087bcbe6cc139571a3b17f33910dd686178f66449fd3c8')

def find_node(nvm_root=Path('/usr/local/nvm')):
    source = shutil.which('node')
    if source:
        return Path(source)
    candidates = sorted((path for path in nvm_root.glob('versions/node/*/bin/node') if path.is_file() and os.access(path, os.X_OK)))
    if len(candidates) > 1:
        raise RuntimeError('Multiple nvm Node versions without an active Node in PATH')
    return candidates[0] if candidates else None

def prepare_utilities(root):
    if os.environ.get('IS_SANDBOX') != '1' or not os.environ.get('ARENA_TASK_ID'):
        raise RuntimeError('This adapter requires an EnvArena sandbox')
    for name in ('bwrap', 'rg'):
        source = root / 'bin' / ('bwrap' if name == 'bwrap' else 'tools/rg')
        target = Path('/usr/bin/bwrap') if name == 'bwrap' else Path('/usr/local/bin/rg')
        if not target.exists():
            shutil.copy2(source, target)
            target.chmod(493)
    for source in (root / 'lib').iterdir():
        target = Path('/lib') / source.name
        if not target.exists():
            shutil.copy2(source, target)
    node = find_node()
    for name in ('node', 'npm', 'npx'):
        sibling = node.parent / name if node else None
        source = str(sibling) if sibling and sibling.exists() else shutil.which(name)
        target = Path('/usr/local/bin') / name
        if source and (not target.exists()):
            if target.is_symlink():
                target.unlink()
            target.symlink_to(source)
    subprocess.run(['/usr/bin/bwrap', '--unshare-all', '--ro-bind', '/', '/', '--', '/bin/true'], check=True, timeout=20)
    return {'node': str(node) if node else None}

def project_item(item):
    kind = item['type']
    identity = item['id']
    if kind == 'userMessage':
        content = []
        for part in item['content']:
            if part['type'] == 'text':
                content.append({'type': 'text', 'text': part['text']})
            else:
                content.append({'type': 'text', 'text': '[Input media] ' + json.dumps(part)})
        return [{'type': 'user', 'message': {'id': identity, 'role': 'user', 'content': content}}]
    if kind == 'agentMessage':
        return [{'type': 'assistant', 'message': {'id': identity, 'role': 'assistant', 'content': [{'type': 'text', 'text': item['text']}]}}]
    if kind == 'reasoning':
        thinking_text = ''.join(item.get('content') or [])
        if thinking_text:
            return [{'type': 'assistant', 'message': {'id': identity, 'role': 'assistant', 'content': [{'type': 'thinking', 'thinking': thinking_text}]}}]
        return [{'type': 'core_item', 'item': item}]
    if kind == 'modelContext':
        value = item['value']
        if value.get('type') == 'chat_reasoning':
            return [{'type': 'assistant', 'message': {'id': identity, 'role': 'assistant', 'content': [{'type': 'thinking', 'thinking': value['reasoning_content']}]}}]
        return [{'type': 'model_context', 'item': item}]
    if kind == 'dynamicToolCall':
        return [{'type': 'assistant', 'message': {'id': identity, 'role': 'assistant', 'content': [{'type': 'tool_use', 'id': item['callId'], 'name': item['tool'], 'input': item['arguments']}]}}, {'type': 'user', 'message': {'id': identity + '-result', 'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': item['callId'], 'is_error': not item.get('success'), 'content': json.dumps(item.get('contentItems'), ensure_ascii=False)}]}}]
    return [{'type': 'core_item', 'item': item}]


def emit_public_progress(event):
    """Emit tool metadata only; never tool arguments, output or model text."""
    message = event.get('message', {})
    if not isinstance(message, dict):
        return
    content = message.get('content', [])
    if not isinstance(content, list):
        return
    allowed = {'run_command','read_process','fs_read','fs_list','fs_write',
        'read_file','write_file','skill_read','skill_list','image_read'}
    for part in content:
        if not isinstance(part, dict):
            continue
        kind = part.get('type')
        if kind == 'tool_use':
            name = part.get('name')
            record = {'kind':'tool_call','tool':name if isinstance(name,str) and name in allowed else 'other'}
        elif kind == 'tool_result':
            value = part.get('is_error')
            record = {'kind':'tool_result','is_error':value if type(value) is bool else None}
        else:
            continue
        record['observed_at_unix_ms'] = int(time.time()*1000)
        print('CC_NATIVE_PROGRESS '+json.dumps(record,sort_keys=True),flush=True)

def project(data, trajectory, seen):
    threads = []
    for path in sorted(data.glob('*.json')):
        thread = json.loads(path.read_text())['thread']
        threads.append(thread)
        for turn in thread.get('turns', []):
            items = turn['items']
            for (index, item) in enumerate(items):
                identity = item['id']
                if identity in seen or item.get('status') == 'inProgress':
                    continue
                if item['type'] == 'agentMessage' and index == len(items) - 1 and (turn['status'] == 'inProgress'):
                    continue
                for event in project_item(item):
                    event.update({'thread_id': thread['id'], 'turn_id': turn['id']})
                    trajectory.write(json.dumps(event, ensure_ascii=False) + '\n')
                    emit_public_progress(event)
                seen.add(identity)
    trajectory.flush()
    return threads

def make_config(model, endpoint, timeout, settings=None):
    settings = settings or {}
    q = json.dumps
    effort = os.environ.get('AREAL_ARENA_REASONING_EFFORT', settings.get('reasoning_effort', 'medium'))
    temperature = os.environ.get('AREAL_ARENA_TEMPERATURE', settings.get('temperature', 1))
    sampling = (f'reasoning_effort={q(effort)}\n' if effort is not None else '') + (f'temperature={float(temperature)}\n' if temperature is not None else '')
    history_thinking = os.environ.get('AREAL_ARENA_HISTORY_THINKING', settings.get('history_thinking', 'preserve'))
    max_request_bytes = int(settings.get('max_request_bytes', 33554432))
    return f"""schema_version=1\n[model]\nprovider="arena"\nname={q(model)}\nhistory_thinking={q(history_thinking)}\nmax_request_bytes={max_request_bytes}\n{sampling}max_retries={int(settings.get('http_retries', 2))}\n[model.providers.arena]\nprotocol="chat-completions"\nendpoint={q(endpoint)}\napi_key_env="AREAL_API_KEY"\n[limits]\nstream_idle_timeout_seconds={int(settings.get('stream_idle_timeout_seconds', 900))}\nmax_completion_retries={int(settings.get('max_completion_retries', 0))}\nmax_history_bytes=134217728\nmax_output_bytes=16777216\nmax_tool_calls=0\ncontext_window_bytes={int(settings.get('context_window_bytes', 196608))}\ncontext_compaction_enabled=false\ncontext_recent_bytes={int(settings.get('context_recent_bytes', 65536))}\ncontext_window_tokens={int(settings.get('context_window_tokens', 0))}\ncontext_output_reserve_tokens={int(settings.get('context_output_reserve_tokens', 0))}\nmax_children_per_turn=0\nmax_agent_depth=0\n""" + ("\n[tools]\nextensions_file=" + q(settings["lab_extensions_file"]) + "\n" if settings.get("lab_extensions_file") else "")

def model_connection():
    model = os.environ.get('OPENAI_MODEL') or os.environ.get('ANTHROPIC_MODEL') or os.environ.get('MODEL_NAME')
    base = os.environ.get('OPENAI_BASE_URL') or os.environ.get('ANTHROPIC_BASE_URL') or os.environ.get('LLM_BASE_URL')
    key = os.environ.get('OPENAI_API_KEY') or os.environ.get('ANTHROPIC_AUTH_TOKEN') or os.environ.get('ANTHROPIC_API_KEY')
    if not model or not base or (not key):
        raise RuntimeError('Model must provide model name, gateway base URL and a credential')
    base = base.rstrip('/')
    return (model, base + ('/chat/completions' if base.endswith('/v1') else '/v1/chat/completions'), key)

def has_tracked_changes(workspace):
    result = subprocess.run(['git', '-c', 'core.fileMode=false', 'diff', '--quiet', '--no-ext-diff', '--no-textconv', 'HEAD', '--'], cwd=workspace, env={'PATH': '/usr/bin:/bin', 'GIT_OPTIONAL_LOCKS': '0'}, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=15)
    if result.returncode not in (0, 1):
        raise RuntimeError('Cannot inspect task workspace changes: ' + result.stderr.decode(errors='replace'))
    return result.returncode == 1

def completion_confirmed(turns):
    if not turns:
        return False
    text = '\n'.join((item.get('text', '') for item in turns[-1].get('items', []) if item['type'] == 'agentMessage'))
    return any((line.strip() in ('IMPLEMENTATION_COMPLETE', 'IMPLEMENTATION_BLOCKED', 'IMPLEMENTATION_NO_CHANGE') for line in text.splitlines()))

def phase_clock(now=None, environ=None):
    """Use the versioned loader's pre-extraction clock; never extend phase time."""
    now = time.monotonic() if now is None else now
    environ = os.environ if environ is None else environ
    budget = int(environ.get('ARENA_AGENT_TIMEOUT_SEC', '14400'))
    if budget < 1:
        raise ValueError('Positive Arena phase budget required')
    start = float(environ.get('AREAL_ARENA_PHASE_STARTED_MONOTONIC', now))
    if not 0 <= now - start <= budget:
        raise ValueError('Invalid versioned loader phase clock')
    work = max(30, budget - 600)
    stop_after = max(0, min(work + 15, budget - 120))
    return (start, budget, work, stop_after)

def prepare_bound_public_input(query):
    workspace = Path(os.environ.get('ARENA_AGENT_WORKDIR') or os.environ.get('ARENA_WORKSPACE') or '/envarena/workspace')
    materials = workspace / 'materials'
    names = {'anchor.jpg', 'three-views.png'}
    if materials.is_symlink() or not materials.is_dir():
        raise ValueError('Approved public materials directory missing')
    for name in names:
        path = materials / name
        if path.is_symlink() or not path.is_file() or path.stat().st_size == 0:
            raise ValueError('Approved public input image missing: ' + name)
    (parts, images) = prepare_input(query, assets=materials, allowed_names=names)
    if {Path(image['path']).name for image in images} != names or len(images) != 2:
        raise ValueError('Exactly the two approved public images required')
    return (parts, images)

def archive_bound_public_inputs(images, destination):
    destination.mkdir(parents=True, exist_ok=True)
    for image in images:
        source = Path(image['path'])
        if source.is_symlink() or hashlib.sha256(source.read_bytes()).hexdigest() != image['sha256']:
            raise ValueError('Approved public image changed before raw archival')
        shutil.copy2(source, destination / source.name)


def inspect_blender_delivery(workspace, output, remaining):
    """Inspect public scene delivery, never private scoring or quality thresholds."""
    candidates=[Path(workspace)/'scene.blend',Path(output)/'scene.blend']
    # Public contracts may name a nested scene. Resolve only paths inside the
    # existing workspace/output; never accept an unrelated task checkpoint.
    contract=Path(workspace)/'output-contract.json'
    if contract.is_file() and contract.stat().st_size<=512*1024:
        def paths(value):
            if isinstance(value,str) and value.endswith('.blend'):yield value
            elif isinstance(value,dict):
                for child in value.values():yield from paths(child)
            elif isinstance(value,list):
                for child in value:yield from paths(child)
        for name in paths(json.loads(contract.read_text())):
            for base in (Path(workspace),Path(output)):
                candidate=(base/name).resolve()
                if candidate.is_relative_to(base.resolve()) and candidate not in candidates:candidates.append(candidate)
    candidates=[p for p in candidates[:16] if p.is_file() and not p.is_symlink() and p.stat().st_size>0]
    if not candidates:return {'status':'incomplete','reasons':['No required scene.blend has been delivered'],'scenes':[]}
    if remaining<120:return {'status':'incomplete','reasons':['Insufficient native work budget for independent reopen'],'scenes':[]}
    min_required_faces=500000
    checks=[]
    face_reasons=[]
    for path in candidates[:4]:
        script=("import bpy,json\n"
            +"bpy.ops.wm.open_mainfile(filepath="+repr(str(path))+",use_scripts=False)\n"
            +"scene=bpy.context.scene\n"
            +"deps=bpy.context.evaluated_depsgraph_get()\n"
            +"geometry=[o for o in scene.objects if o.type in {'MESH','CURVE','SURFACE','META','FONT','VOLUME','POINTCLOUD','CURVES','GREASEPENCIL'} and not o.hide_render]\n"
            +"total_faces=0\n"
            +"for o in scene.objects:\n"
            +"    if o.type=='MESH' and o.data is not None and not o.hide_render:\n"
            +"        eo=o.evaluated_get(deps)\n"
            +"        me=eo.to_mesh()\n"
            +"        total_faces+=len(me.polygons)\n"
            +"        eo.to_mesh_clear()\n"
            +"print('CC_BLENDER_DELIVERY='+json.dumps({'opened':True,'geometry_objects':len(geometry),'total_faces':total_faces,'min_required_faces':500000}))\n")
        try:
            process=subprocess.run(['blender','--background','--factory-startup','--disable-autoexec','--python-exit-code','1','--python-expr',script],
                stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=min(90,max(1,remaining-30)))
            lines=process.stdout.decode(errors='replace').splitlines()
            probe=next((json.loads(line.split('=',1)[1]) for line in lines if line.startswith('CC_BLENDER_DELIVERY=')),{})
            check={'path':str(path),'return_code':process.returncode,**probe}
            checks.append(check)
            if process.returncode==0 and probe.get('opened') and probe.get('geometry_objects',0)>0:
                if int(probe.get('total_faces',0))>=min_required_faces:
                    return {'status':'complete','reasons':[],'scenes':checks,'scope':'Independent open, nonempty geometry and total_faces >= 500000 closeout gate; original formal scoring unchanged'}
                face_reasons.append(
                    f"Delivered scene {path.name} has total_faces={int(probe.get('total_faces',0)):,} (< 500,000 mandatory minimum). "
                    "Do NOT call bpy.ops.wm.save_as_mainfile directly; reopen scene.blend and save via "
                    "finalize_and_save('scene.blend') from .agents/skills/harness-lab/lab_update_subpart.py so total_faces >= 500,000"
                )
        except (subprocess.TimeoutExpired,ValueError,OSError) as error:
            checks.append({'path':str(path),'probe_error':type(error).__name__})
    return {'status':'incomplete','reasons':face_reasons or ['Delivered scene did not pass independent Blender reopen/nonempty geometry inspection'],'scenes':checks}


def inspect_delivery_in_closeout(workspace, output, phase_started, phase_budget):
    # Native model work and continuations keep their existing deadline. This
    # read-only reopen uses the Agent phase's already reserved closeout time.
    phase_remaining = int(phase_budget - (time.monotonic() - phase_started))
    check_budget = max(0, min(600, phase_remaining - 30))
    delivery = inspect_blender_delivery(workspace, output, check_budget)
    delivery['closeout_budget_seconds'] = check_budget
    delivery['budget_source'] = 'Actual Agent phase remaining; native work deadline unchanged'
    return delivery

